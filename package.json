{
  "name": "momentum-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=11.1.3"
  },
  "scripts": {
    "build": "turbo run build --filter=!@momentum-ui/react-storybook",
    "build:storybook": "pnpm --filter @momentum-ui/react-storybook build",
    "changeset": "changeset",
    "dev": "turbo run dev --parallel --filter=@momentum-ui/playground-react --filter=@momentum-ui/react-storybook",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint && markdownlint-cli2 AGENTS.md CLAUDE.md \"docs/**/*.md\"",
    "postinstall": "node ./scripts/patch-storybook-windows-cache.mjs",
    "storybook": "pnpm --filter @momentum-ui/react-storybook storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.4.0",
    "@storybook/react-vite": "10.4.0",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.3",
    "storybook": "10.4.0",
    "tsup": "8.5.1",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
